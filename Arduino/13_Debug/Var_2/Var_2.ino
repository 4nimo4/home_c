// ============================================================================
//   ДОМАШНЯЯ МЕТЕОСТАНЦИЯ / ИМИТАТОР ИЛС ДЛЯ UNO R4 WIFI
//
//   Датчики:
//     - AHT20: температура и влажность воздуха (I2C)
//     - BMP280: давление и барометрическая высота (I2C)
//     - MPU6050: акселерометр + гироскоп, даёт "горизонт" и температуру (I2C)
//
//   Дисплей:
//     - TFT ST7735 1.8", 128x160, управление по SPI
//
//   Основные режимы экрана (displayMode):
//     0 – METEO: погода, давление, тренд, температура MPU, статусы датчиков
//     1 – HUD: искусственный горизонт (крен/тангаж), виртуальный курс,
//              "лестничная" высота, численные значения углов и высоты
//
//   Кнопка (D2, INPUT_PULLUP):
//     - короткое нажатие  (< 1.5 c) – переключение между METEO и HUD;
//     - длинное нажатие  (>= 1.5 c), только в HUD и при живом MPU –
//         ручной "сброс нуля":
//           * запоминаем текущее положение как ноль горизонта
//             (roll_zero_deg / pitch_zero_deg);
//           * обнуляем виртуальный курс (heading_deg = 0) относительно этого
//             горизонта;
//           * флаги horizonZeroSet / headingZeroSet = true.
//
//   Особенности логики:
//     - MPU6050 даёт крен/тангаж; ноль горизонта запоминается один раз при
//       первом успешном initMPU() и/или при ручном "сбросе нуля" кнопкой.
//     - Виртуальный курс считается по интегралу крена (heading_deg), ноль курса
//       так же запоминается один раз (initMPU или ручной сброс).
//     - Высота по BMP280: при старте усредняется несколько измерений, это место
//       принимается за "0 м" (altitudeOffset_m). Для HUD используется
//       сглаженная и "квантуемая" высота altStep_m.
//     - Любая серьёзная ошибка ENV (AHT/BMP) или MPU → общий сброс питания
//       всех датчиков (reinitAllSensors()), перекалибровка и "тихий" период
//       recovering, чтобы не зациклиться на ошибках.
// ============================================================================

#include <Arduino.h>
