// ============================================================================
//   [F16] reinitAllSensors – общий ПОЛНЫЙ сброс AHT/BMP + MPU
//   Используется при серьёзных ошибках ENV или MPU:
//     - полностью выключаем питание всех датчиков;
//     - включаем питание заново;
//     - переинициализируем AHT20, BMP280, MPU6050;
//     - включаем "тихий" период recovering, чтобы не дёргать их сразу снова.
// ============================================================================
void reinitAllSensors(const char* reason) {
  // Логируем причину, по которой решили перезапустить все датчики
  Serial.print("Reinit ALL sensors (ENV + MPU), reason: ");
  Serial.println(reason);

  // [F16.1] Выключаем ВСЁ питание датчиков одновременным действием
  // ----------------------------------------------------------------
  // Отключаем питание:
  //   - AHT20/BMP280 через AHT_BMP_PWR_PIN (PNP BC327, HIGH = выкл)
  //   - MPU6050       через MPU_PWR_PIN     (PNP BC327, HIGH = выкл)
  // И одновременно гасим светодиоды-индикаторы питания.
  digitalWrite(AHT_BMP_PWR_PIN, HIGH);    // OFF AHT/BMP (отключаем 3.3V)
  digitalWrite(MPU_PWR_PIN,     HIGH);    // OFF MPU   (отключаем 5V)
  digitalWrite(SV1_INDIC_PWR_PIN, LOW);   // LED ENV OFF
  digitalWrite(SV2_MPU_INDIC_PIN, LOW);   // LED MPU OFF
  delay(250);                             // даём питанию полностью "упасть"

  // [F16.2] Включаем ВСЁ питание датчиков одновременным действием
  // ----------------------------------------------------------------
  // Включаем питание на тех же линиях и зажигаем LED-индикаторы.
  digitalWrite(AHT_BMP_PWR_PIN, LOW);     // ON AHT/BMP (подаём 3.3V)
  digitalWrite(MPU_PWR_PIN,     LOW);     // ON MPU    (подаём 5V)
  digitalWrite(SV1_INDIC_PWR_PIN, HIGH);  // LED ENV ON
  digitalWrite(SV2_MPU_INDIC_PIN, HIGH);  // LED MPU ON
  delay(300);                             // даём датчикам время включиться

  // [F16.3] Инициализация ENV (AHT20 + BMP280)
  // ----------------------------------------------------------------
  Serial.println("Reinit ALL: calling aht.begin() / bmp.begin()");

  // Пытаемся снова запустить AHT20
  bool aht_ok_new = aht.begin();
  aht_ok = aht_ok_new;          // обновляем глобальный флаг состояния AHT
  if (!aht_ok_new) ahtErrCount++; // если опять не удалось – увеличиваем "память ошибок" AHT

  // Пытаемся снова запустить BMP280 по адресам 0x76 или 0x77
  bool bmp_ok_new = (bmp.begin(0x76) || bmp.begin(0x77));
  bmp_ok = bmp_ok_new;          // обновляем глобальный флаг состояния BMP
  if (!bmp_ok_new) bmpErrCount++; // если не удалось – увеличиваем "память ошибок" BMP

  // Логируем результат перезапуска ENV
  Serial.print("Reinit ALL: AHT=");
  Serial.print(aht_ok_new ? "OK" : "ERR");
  Serial.print(" BMP=");
  Serial.println(bmp_ok_new ? "OK" : "ERR");

  // [F16.4] Инициализация MPU6050
  // ----------------------------------------------------------------
  Serial.println("Reinit ALL: calling initMPU()");
  bool mpu_ok_new = initMPU();  // полная инициализация/калибровка MPU
  mpu_ok    = mpu_ok_new;       // глобальный флаг состояния MPU
  mpu_error = !mpu_ok_new;      // фиксируем последнюю ошибку

  Serial.print("Reinit ALL: MPU=");
  Serial.println(mpu_ok_new ? "OK" : "ERR");

  // [F16.5] Служебные флаги и «тихий» период после reinit
  // ----------------------------------------------------------------
  // Обнуляем текущую серию ошибок чтения MPU.
  mpuReadErrorStreak = 0;

  // Включаем режим recovering, чтобы немного "подождать" после реинициализации:
  //   - recovering = true     -> ENV/MPU в некоторых местах не опрашиваются;
  //   - recoverUntilMs        -> время, когда "тихий" период закончится.
  recovering = true;
  recoverUntilMs = millis() + RECOVER_MS;  // RECOVER_MS обычно 2000 мс (2 секунды)
}

// ============================================================================
//   [F16.6] manualZeroReset – ручной сброс нуля горизонта и курса
//   Вызывается при длинном нажатии кнопки в HUD-режиме, когда MPU в строю.
//   Логика:
//     - считаем текущую ориентацию по сглаженному акселерометру;
//     - принимаем её за "новый ноль" горизонта;
//     - обнуляем виртуальный курс относительно этого горизонта;
//     - обновляем флаги horizonZeroSet / headingZeroSet.
// ============================================================================
void manualZeroReset() {
  // Используем текущие сглаженные ax_f/ay_f/az_f для вычисления "сырых" углов
  // по тем же формулам, что в [F18.2.3].
  float roll_rad  = atan2(ay_f, az_f);
  float pitch_rad = atan2(-ax_f, sqrt(ay_f * ay_f + az_f * az_f));

  // Переводим в градусы
  float roll_raw_deg  = roll_rad  * 180.0f / PI;
  float pitch_raw_deg = pitch_rad * 180.0f / PI;

  // Ставим текущее "физическое" положение как новый ноль горизонта:
  //   - roll_zero_deg/pitch_zero_deg теперь соответствуют тому, как
  //     плата была ориентирована в момент длинного нажатия.
  roll_zero_deg  = roll_raw_deg;
  pitch_zero_deg = pitch_raw_deg;
  horizonZeroSet = true;   // помечаем, что ноль горизонта определён

  // Приводим текущие углы к нулю относительно нового нуля (по идее ~0/0)
  roll_deg  = roll_raw_deg  - roll_zero_deg;
  pitch_deg = pitch_raw_deg - pitch_zero_deg;

  // Сбрасываем виртуальный курс относительно нового нуля горизонта:
  //   - текущий heading_deg = 0;
  //   - last_roll_for_heading = текущий крен (около 0);
  //   - headingInitDone/headingZeroSet = true.
  heading_deg           = 0.0f;
  last_roll_for_heading = roll_deg;
  headingInitDone       = true;
  headingZeroSet        = true;

  // Логируем новый ноль горизонта
  Serial.println("MANUAL ZERO RESET:");
  Serial.print("  roll_zero_deg=");
  Serial.print(roll_zero_deg, 1);
  Serial.print("  pitch_zero_deg=");
  Serial.println(pitch_zero_deg, 1);

  // Краткое сообщение на TFT о том, что ноль был сброшен
  tft.fillScreen(COL_FON1);
  tft.setTextWrap(false);
  tft.setTextColor(ST77XX_YELLOW, COL_FON1);
  tft.setTextSize(1);
  tft.setCursor(10, tft.height() / 2 - 10);
  tft.print("ZERO RESET");
  tft.setCursor(10, tft.height() / 2);
  tft.print("HORIZON & HDG");
  delay(800);   // короткая пауза, чтобы успеть прочитать надпись

  // После сообщения восстанавливаем текущий экранный фрейм:
  //   - если сейчас METEO -> перерисовать каркас METEO;
  //   - если HUD         -> перерисовать каркас HUD.
  // lastScreenUpdate = 0, чтобы форсировать немедленное обновление.
  if (displayMode == 0) {
    drawEnvFrame();
    lastScreenUpdate = 0;
  } else {
    drawMPUFrame();
    lastScreenUpdate = 0;
  }
}

// ============================================================================
//   [F17] setup – инициализация устройств
// ============================================================================
void setup() {
  // Поднимаем Serial для отладки
  Serial.begin(115200);
  while (!Serial) {         // ждём готовности USB-Serial (актуально для UNO R4)
    delay(10);
  }

  Serial.println("=== SETUP START ===");

  // Инициализация I2C-шины (общая шина для AHT20, BMP280, MPU6050)
  Wire.begin();
  Wire.setClock(100000);    // 100 кГц – надёжная скорость

  // Настройка пинов ввода/вывода
  pinMode(buttonPin,         INPUT_PULLUP); // кнопка: внутр. подтяжка к Vcc
  pinMode(AHT_BMP_PWR_PIN,   OUTPUT);       // питание AHT/BMP
  pinMode(SV1_INDIC_PWR_PIN, OUTPUT);       // LED AHT/BMP
  pinMode(MPU_PWR_PIN,       OUTPUT);       // питание MPU6050
  pinMode(SV2_MPU_INDIC_PIN, OUTPUT);       // LED MPU

  // [F17.1] Питание AHT/BMP (3.3V через BC327)
  // Сначала гарантированно выключаем питание, затем включаем: "холодный" старт.
  digitalWrite(AHT_BMP_PWR_PIN, HIGH);   // HIGH = выкл питания AHT/BMP
  digitalWrite(SV1_INDIC_PWR_PIN, LOW);  // LED AHT/BMP выкл
  delay(50);

  digitalWrite(AHT_BMP_PWR_PIN, LOW);    // LOW = вкл питания AHT/BMP
  digitalWrite(SV1_INDIC_PWR_PIN, HIGH); // LED AHT/BMP вкл
  delay(100);                            // ждём стабилизации

  // [F17.2] Питание MPU6050 (5V через BC327)
  digitalWrite(MPU_PWR_PIN, HIGH);       // пока выключено питание MPU
  digitalWrite(SV2_MPU_INDIC_PIN, LOW);  // LED MPU выкл
  delay(50);

  digitalWrite(MPU_PWR_PIN, LOW);        // включаем 5V на MPU6050
  digitalWrite(SV2_MPU_INDIC_PIN, HIGH); // LED MPU вкл
  delay(300);                            // даём MPU "проснуться"

  // [F17.3] Инициализация TFT
  tft.initR(INITR_BLACKTAB);             // базовая инициализация ST7735
  tft.setRotation(SET_ROTAC);            // поворот экрана
  tft.fillScreen(COL_FON1);              // заливаем фон (фиолетовый)
  tft.setTextWrap(false);                // не переносить текст автоматически

  // Сообщение "INIT SENS" на время инициализации датчиков ENV/MPU
  showMessageTFT("INIT SENS", ZAGOLOVOK, COL_TEXT1, COL_FON1);
  delay(500);

  // [F17.4] Инициализация AHT20
  if (!aht.begin()) {
    // AHT20 не ответил
    aht_ok = false;
    Serial.println("AHT20 not found");
    showMessageTFT("AHT20 ERR", ZAGOLOVOK, COL_TEXT4, COL_FON4);
    delay(500);

    // Увеличиваем "память ошибок" AHT20:
    //   ahtErrCount – это накопительный счётчик, который НЕ обнуляется
    //   при reinitAllSensors(). По нему можно понять, сколько раз за всё
    //   время работы AHT20 не инициализировался или перестал отвечать.
    ahtErrCount++;

    // Фиксируем общую потерю связи по ENV-части:
    //   poterya_svyazi = true означает, что хотя бы один из ENV-датчиков
    //   (AHT20 или BMP280) при старте не вышел в рабочий режим.
    //   Этот флаг можно использовать дальше для принятия решений
    //   об автоматическом восстановлении, логике "ожидания" и т.п.
    poterya_svyazi = true;

    // Запоминаем момент, когда произошла эта ошибка AHT20:
    //   lastAhtRetry является "опорной точкой" для таймеров повторной
    //   попытки инициализации (AHT_RETRY_INTERVAL). Это позволяет
    //   не дёргать датчик постоянно, а подождать разумную паузу.
    lastAhtRetry   = millis();
  } else {
    aht_ok = true;
    Serial.println("AHT20 OK");
    showMessageTFT("AHT20 OK", ZAGOLOVOK, COL_TEXT5, COL_FON5);
    delay(500);
  }

  // [F17.5] Инициализация BMP280
  if (!bmp.begin(0x76) && !bmp.begin(0x77)) {
    // ни по 0x76, ни по 0x77 BMP280 не найден
    bmp_ok = false;
    Serial.println("BMP280 not found");
    showMessageTFT("BMP280 ERR", ZAGOLOVOK, COL_TEXT6, COL_FON6);
    delay(500);

     // Увеличиваем "память ошибок" BMP280:
    //   bmpErrCount – накопительный счётчик всех случаев, когда BMP280
    //   не нашёлся на шине или не инициализировался. Аналогично AHT,
    //   этот счётчик помогает оценить надёжность датчика за всё время работы.
    bmpErrCount++;

    // Если до этого ещё не было зафиксировано, что ENV "отвалился"...
    if (!poterya_svyazi) {
      // ...то ставим общий флаг потери связи по ENV.
      //   Сейчас причиной стал именно BMP280, но логика выше смотрит
      //   только на сам факт, что "что-то из ENV работает нестабильно".
      poterya_svyazi = true;

      // И также обновляем lastAhtRetry (общая "опорная метка" времени
      // для повторных попыток восстановления ENV-части).
      // Название переменной историческое, используется и для AHT, и для BMP.
      lastAhtRetry   = millis();
    }
  } else {
    bmp_ok = true;
    Serial.println("BMP280 OK");
    showMessageTFT("BMP280 OK", ZAGOLOVOK, COL_TEXT7, COL_FON7);
    delay(500);

    // Настраиваем режим работы BMP280.
    // setSampling() управляет тем, КАК датчик будет измерять давление/температуру:
    //
    //   1) Режим работы (MODE_NORMAL):
    //        - BMP280 сам циклически делает измерения
    //        - между измерениями делает "стойку" (STANDBY)
    //
    //   2) Oversampling (SAMPLING_X2 / SAMPLING_X16):
    //        - сколько внутренних измерений усредняются для одного результата;
    //        - чем выше множитель, тем меньше шум, но дольше измерение.
    //
    //   3) Фильтр (FILTER_X16):
    //        - встроенный цифровой фильтр BMP280, сглаживает быстрые колебания;
    //        - помогает убрать дрожание высоты от шума давления.
    //
    //   4) Standby (STANDBY_MS_500):
    //        - пауза между циклами измерений в режиме MODE_NORMAL;
    //        - влияет на частоту обновления внутренних данных датчика.
    //
    // В нашем случае настройки такие:
    //   MODE_NORMAL      – постоянные измерения без ручного "просыпания";
    //   SAMPLING_X2 T    – небольшой oversampling по температуре
    //                       (температура нам нужна скорее как фон, а не эталон);
    //   SAMPLING_X16 P   – сильное усреднение давления, чтобы высота была
    //                       максимально стабильной, пусть даже чуть "ленивой";
    //   FILTER_X16       – максимальный встроенный фильтр BMP280, ещё одно
    //                       сглаживание поверх oversampling'а;
    //   STANDBY_MS_500   – внутри BMP280 новое измерение раз в ~0.5 секунды,
    //                       этого достаточно для медленных баро-изменений.
    bmp.setSampling(
      Adafruit_BMP280::MODE_NORMAL,   // режим непрерывных измерений
      Adafruit_BMP280::SAMPLING_X2,  // oversampling температуры: 2x
      Adafruit_BMP280::SAMPLING_X16, // oversampling давления: 16x
      Adafruit_BMP280::FILTER_X16,   // максимальный цифровой фильтр
      Adafruit_BMP280::STANDBY_MS_500 // пауза между циклами ~500 мс
    );

    // [F17.5.1] Калибровка высоты: принимаем текущую точку как "0 м".
    //
    //   Идея:
    //     - BMP280 выдаёт абсолютную высоту относительно уровня моря
    //       при заданном опорном давлении SEA_LEVEL_HPA.
    //     - Нас интересует относительная высота (на сколько мы поднялись/опустились
    //       относительно МЕСТА УСТАНОВКИ прибора), а не истинный уровень над морем.
    //     - Поэтому при включении мы многократно считываем высоту и усредняем её:
    //       это будет наша "нулевая" высота altitudeOffset_m.
    //
    //   Почему несколько измерений:
    //     - одно измерение может быть зашумлено (микроколебания давления);
    //     - усреднение 20 раз даёт более стабильное начальное значение.
    //
    const int ALT_CAL_SAMPLES = 20;  // сколько раз считываем высоту для усреднения
    float sumAlt = 0.0f;             // сумма всех измерений высоты

    for (int i = 0; i < ALT_CAL_SAMPLES; i++) {
      // bmp.readAltitude(SEA_LEVEL_HPA) возвращает абсолютную высоту (в метрах)
      // исходя из текущего давления и заданного уровня моря SEA_LEVEL_HPA.
      float altSample = bmp.readAltitude(SEA_LEVEL_HPA);
      sumAlt += altSample;
      delay(50);  // небольшая пауза между измерениями, чтобы датчик успел обновиться
    }

    float a0 = sumAlt / ALT_CAL_SAMPLES;  // средняя высота по месту установки
    altitudeOffset_m = a0;                // запоминаем как "0 м"
    altitude_m       = 0.0f;              // относительная высота = 0
    altitude_m_f     = 0.0f;              // и сглаженная тоже

    // Для контроля выводим в Serial калиброванное "нулевое" значение высоты:
    //   Alt0 (calibrated avg) = <a0>
    // где a0 – средняя абсолютная высота (в метрах) по 20 измерениям.
    // Ниже мы принимаем её за 0 м для всех дальнейших относительных высот.
    Serial.print("Alt0 (calibrated avg) = ");
    Serial.println(a0);      // в метрах, от bmp.readAltitude(SEA_LEVEL_HPA)
  }

  // [F17.6] Инициализация MPU6050 через initMPU (после ENV)
  Serial.println("=== MPU init from setup (after ENV) ===");
  bool mpu_init_ok = initMPU();           // initMPU сам калибрует и фиксирует ноль горизонта/курса
  Serial.print("MPU init in setup = ");
  Serial.println(mpu_init_ok ? "OK" : "ERR");

  if (mpu_init_ok) {
    showMessageTFT("MPU OK", ZAGOLOVOK, COL_TEXT2, COL_FON2);
  } else {
    showMessageTFT("MPU ERR", ZAGOLOVOK, COL_TEXT3, COL_FON3);
  }
  delay(500);

  // Стартуем в METEO-режиме
  displayMode = 0;
  drawEnvFrame();                         // рисуем каркас METEO-экрана (подписи)

  unsigned long now = millis();
  lastScreenUpdate = now;                 // время последнего обновления экрана
  lastSerialPrint  = now;                 // время последнего METEO-лога в Serial
  startTime        = now;                 // для логики стабилизации высоты

  // Запускаем CBTimer на 1 Гц – для миганий и прочих периодических задач
  uiTimer.begin(1000, uiTimerCallback, true);

   // Стартовый лог по высоте и скорости I2C.
  // ALT_zero:
  //   - если altZeroRefSet == true, значит ноль высоты уже был захвачен
  //     ранее (в процессе работы, после периода стабилизации) – выводим altZeroRef;
  //   - если altZeroRefSet == false (обычно сразу после включения),
  //     то в качестве "нуля" используем altitudeOffset_m (усреднённую высоту при старте).
  //
  // ALT_offset_m:
  //   - базовая "нулевая" высота по месту установки, полученная при калибровке
  //     BMP280 в setup() (среднее из ALT_CAL_SAMPLES измерений).
  //
  // I2C_speed:
  //   - текущая частота шины I2C (мы выше задали 100000 Гц).
  Serial.print("START: ALT_zero=");
  Serial.print(altZeroRefSet ? altZeroRef : altitudeOffset_m, 2);
  Serial.print("  ALT_offset_m=");
  Serial.print(altitudeOffset_m, 2);
  Serial.print("  I2C_speed=");
  Serial.print(100000);
  Serial.println("Hz");

  Serial.println("=== SETUP DONE ===");
}

// ============================================================================
//   [F18] loop – основной цикл
//   Структура:
//     1) Обработка "тихого" периода после reinitAllSensors() (recovering)
//     2) В HUD-режиме: чтение MPU, расчёт крена/тангажа/курса, обработка ошибок MPU
//     3) В METEO/HUD: чтение ENV (AHT/BMP) с разной частотой
//     4) Расчёт тренда давления (METEO)
//     5) Обработка кнопки (короткое / длинное нажатие)
//     6) Периодические логи (ENV+MPU / высота)
//     7) Обновление экрана (METEO/HUD)
// ============================================================================
void loop() {
  // Текущее время в миллисекундах – общий "таймер" цикла
  unsigned long now = millis();

  // --------------------------------------------------------------------------
  // [F18.1] Режим восстановления после общего сброса датчиков
  // --------------------------------------------------------------------------
  // После вызова reinitAllSensors() выставляем:
  //   recovering     = true;
  //   recoverUntilMs = millis() + RECOVER_MS;
  //
  // В этом блоке ждём, пока закончится "тихий" период, чтобы не перезапускать
  // датчики слишком часто и дать им стабилизироваться.
  if (recovering && (long)(recoverUntilMs - now) <= 0) {
    recovering = false;                   // "тихий" период закончился
    Serial.println("RECOVER window finished");
  }

  // --------------------------------------------------------------------------
  // [F18.2] ЧТЕНИЕ MPU + обработка ошибок (только в HUD-режиме)
  // --------------------------------------------------------------------------
  // MPU читаем, только когда активен HUD (displayMode == 1).
  // METEO-экран не требует ориентации/курса, поэтому MPU там не дёргаем.
  if (displayMode == 1) {

    // Если MPU уже в состоянии ошибки (mpu_ok == false) – пытаемся его
    // поднять через общий reinitAllSensors(), но не чаще заданного интервала.
    if (!mpu_ok) {
      unsigned long now2 = millis();                      // текущее время для MPU-ретрая
      const unsigned long MPU_RETRY_INTERVAL_LOCAL = 5000; // минимум 5 секунд между попытками

      if (now2 - lastMpuRetry > MPU_RETRY_INTERVAL_LOCAL) {
        // Давно не пытались – запускаем общий сброс всех датчиков
        lastMpuRetry = now2;
        Serial.println("MPU in ERR state on HUD -> reinitAllSensors()");
        reinitAllSensors("MPU in ERR on HUD");
      }
    } else {
      // ----------------------------------------------------------------------
      // [F18.2.2] mpu_ok == true: нормальное чтение + отслеживание ошибок
      // ----------------------------------------------------------------------

      // Буфер на 14 байт для блока данных MPU:
      //   аксель (6 байт) + температура (2) + гиро (6)
      uint8_t data[14];

      // Пытаемся прочитать с MPU 14 байт, начиная с регистра 0x3B
      uint8_t readCount = mpuRead(0x3B, data, 14);

      // Если прочитали меньше 14 байт – ошибка чтения или сбой по I2C
      if (readCount < 14) {
        unsigned long now2 = millis();             // время ошибки
        unsigned long dt   = now2 - mpuLastInitTime; // сколько прошло с последнего initMPU()
        // diffBmp – время (мс) с момента последнего успешного чтения BMP280(может помочь в диагностике)
        // -1 означает, что BMP ещё ни разу не читали (lastBmpReadMs == 0).
        long diffBmp       = (lastBmpReadMs == 0) ? -1 : (long)now2 - (long)lastBmpReadMs;

        // Логируем факт "укороченного" чтения MPU:
        //   - now2          : текущее время, когда произошла ошибка чтения;
        //   - dt            : сколько миллисекунд прошло с последнего initMPU();
        //   - displayMode   : в каком режиме (METEO/HUD) мы были на момент ошибки;
        //   - diffBmp       : через сколько миллисекунд после последнего чтения BMP280
        //                     произошла эта ошибка (или -1, если BMP ещё не читали).
        Serial.print("MPU short read at ms=");
        Serial.print(now2);           // текущее время ошибки чтения MPU
        Serial.print(" dt since init=");
        Serial.print(dt);            // время с последнего initMPU()
        Serial.print("ms  displayMode=");
        Serial.print(displayMode);   // 0 = METEO, 1 = HUD
        Serial.print("  diffToLastBMP=");
        Serial.print(diffBmp);       // мс с момента последнего чтения BMP или -1
        Serial.println("ms");

         // Дополнительно выводим последнее известное состояние MPU на момент ошибки:
        //   - roll_deg, pitch_deg : "логические" крен и тангаж (уже с учётом нуля горизонта);
        //   - ax_last..az_last    : последние сглаженные значения акселерометра по осям X/Y/Z;
        //   - gx_last..gz_last    : последние сглаженные значения гироскопа (угл. скорость);
        //   - temp_last           : последняя измеренная температура MPU.
        //
        // По этому блоку в логе можно понять:
        //   * был ли в момент ошибки заметный крен/тангаж;
        //   * было ли движение по акселерометру / гироскопу;
        //   * какая была температура датчика (не перегрелся ли).
        Serial.print("MPU state at error: roll=");
        Serial.print(roll_deg, 1);   // крен (градусы, уже относительно нуля горизонта)
        Serial.print(" pitch=");
        Serial.print(pitch_deg, 1);  // тангаж (градусы, относительно нуля горизонта)

        Serial.print("  ax=");
        Serial.print(ax_last, 2);    // аксель X (g), сглаженное значение
        Serial.print(" ay=");
        Serial.print(ay_last, 2);    // аксель Y (g)
        Serial.print(" az=");
        Serial.print(az_last, 2);    // аксель Z (g), в покое ≈ +1 g

        Serial.print("  gx=");
        Serial.print(gx_last, 1);    // гироскоп X (deg/s), сглаженное значение
        Serial.print(" gy=");
        Serial.print(gy_last, 1);    // гироскоп Y (deg/s)
        Serial.print(" gz=");
        Serial.print(gz_last, 1);    // гироскоп Z (deg/s)

        Serial.print("  temp=");
        Serial.print(temp_last, 1);  // температура MPU (°C)
        Serial.println("C");

        // Оценка: "стояли" мы или "двигались" при ошибке MPU.
        // ---------------------------------------------------
        // Идея:
        //   - Если сбои чтения происходят ТОЛЬКО тогда, когда всё стоит неподвижно,
        //     это похоже на проблему "железа" (контакт, пайка, шум по питанию).
        //   - Если сбои появляются ТОЛЬКО при движении, возможно, просадки питания
        //     именно при нагрузке или плохая помехоустойчивость.
        //
        // Поэтому на основе последнего состояния акселя/гиро мы грубо решаем:
        //   "стояли" (still) или "двигались" (moving) в момент ошибки.

        // Условия "покоя" по акселерометру и гироскопу:
        //   ACC_STILL_THRESH  – допустимое отклонение по акселю от идеала;
        //                       в покое: ax≈0, ay≈0, az≈1 g.
        //   GYRO_STILL_THRESH – допустимая угловая скорость в deg/s;
        //                       в покое: gx≈0, gy≈0, gz≈0.
        const float ACC_STILL_THRESH  = 0.05f;  // если модуль отклонения > 0.05 g – считаем, что аксель "шевелится"
        const float GYRO_STILL_THRESH = 5.0f;   // если скорость вращения > 5 deg/s – считаем, что "крутимся"

        // accMoving: хотя бы по одной оси акселерометра вылезли за пределы "тихого" порога.
        //   - по X/Y: просто берём |ax| и |ay|;
        //   - по Z: сравниваем |az - 1.0|, т.к. в покое Z ≈ +1 g (гравитация).
        bool accMoving  = (fabs(ax_last) > ACC_STILL_THRESH) ||
                          (fabs(ay_last) > ACC_STILL_THRESH) ||
                          (fabs(az_last - 1.0f) > ACC_STILL_THRESH);

        // gyroMoving: гироскоп показывает заметное вращение по хотя бы одной оси.
        bool gyroMoving = (fabs(gx_last) > GYRO_STILL_THRESH) ||
                          (fabs(gy_last) > GYRO_STILL_THRESH) ||
                          (fabs(gz_last) > GYRO_STILL_THRESH);

        // Итог: движемся ли сейчас (по любому из датчиков).
        // Если хоть аксель, хоть гироскоп говорят "движемся" – считаем, что движение есть.
        bool movingNow = accMoving || gyroMoving;

        // Статистика ошибок:
        //   - mpuErrWhileStill  – сколько раз ошибка чтения MPU случалась, когда "стояли";
        //   - mpuErrWhileMoving – сколько раз ошибка чтения MPU случалась, когда "двигались".
        // Это помогает понять характер отказов MCU/MPU "по жизни".
        if (movingNow) mpuErrWhileMoving++;
        else           mpuErrWhileStill++;

        // Лог по статистике ошибок на момент текущего сбоя.
        Serial.print("MPU_ERR_STATS: movingNow=");
        Serial.print(movingNow ? "YES" : "NO");  // YES – была динамика, NO – стояли
        Serial.print("  errStill=");
        Serial.print(mpuErrWhileStill);          // всего ошибок "на месте"
        Serial.print("  errMove=");
        Serial.println(mpuErrWhileMoving);       // всего ошибок "в движении"

        // Если ошибка произошла слишком вскоре после initMPU() – игнорируем её,
        // т.к. MPU ещё может не успеть "устаканиться".
        if (dt < MPU_GRACE_MS) {
          Serial.println("MPU read error in grace period, ignored");
        } else {
          // Вышли из "льготного" периода – считаем это полноценной ошибкой чтения
          mpuReadErrorStreak++;   // увеличиваем серию подряд идущих ошибок
          Serial.print("MPU read error (");
          Serial.print(mpuReadErrorStreak);
          Serial.println(")");

          // Если таких ошибок подряд набралось достаточно – инициируем общий сброс датчиков
          if (mpuReadErrorStreak >= 5) {
            unsigned long now2b = millis();
            mpuErrCount++;              // запоминаем ошибку в "памяти MPU"
            mpuReadErrorStreak = 0;     // сбрасываем текущую серию

            // Локальный интервал для повторной попытки восстановления MPU:
            //   MPU_RETRY_INTERVAL_LOCAL = 5000 мс (5 секунд).
            // Идея:
            //   - если мы уже недавно делали reinitAllSensors(), нет смысла
            //     сразу же снова выключать/включать питание датчиков;
            //   - даём системе "подышать" хотя бы 5 секунд перед следующей
            //     серьёзной попыткой восстановления.
            const unsigned long MPU_RETRY_INTERVAL_LOCAL = 5000; // чтобы не дёргать слишком часто

            // Проверяем, прошло ли достаточно времени с последнего reinit по MPU
            if (now2b - lastMpuRetry > MPU_RETRY_INTERVAL_LOCAL) {
              // Прошло больше 5 секунд – можно снова попытаться перезапустить все датчики
              lastMpuRetry = now2b;  // запоминаем время этой попытки

              Serial.println("MPU read error streak -> reinitAllSensors()");
              reinitAllSensors("MPU read errors streak");  // полный сброс ENV + MPU
            } else {
              // Если с последнего reinit прошло меньше 5 секунд – пропускаем,
              // только логируем факт, что серия ошибок есть, но сброс "заглушен".
              Serial.println("MPU read error streak, reinitAllSensors() suppressed (too frequent)");
            }
          }
        }

      } else {
         // --------------------------------------------------------------------
        // [F18.2.3] Успешное чтение MPU – считаем ориентацию и виртуальный курс
        // --------------------------------------------------------------------
        // Так как чтение было полным (14 байт), серия ошибок обнуляется:
        mpuReadErrorStreak = 0;   // предыдущие ошибки "забываем" до следующего сбоя

        // Распаковываем "сырые" 16-битные значения из буфера data.
        // Формат блока данных MPU6050 (начиная с регистра 0x3B):
        //   0,1 : ACCEL_XOUT_H/L
        //   2,3 : ACCEL_YOUT_H/L
        //   4,5 : ACCEL_ZOUT_H/L
        //   6,7 : TEMP_OUT_H/L
        //   8,9 : GYRO_XOUT_H/L
        //  10,11: GYRO_YOUT_H/L
        //  12,13: GYRO_ZOUT_H/L
        int16_t ax_raw  = (int16_t)(data[0] << 8 | data[1]);   // "сырой" аксель X
        int16_t ay_raw  = (int16_t)(data[2] << 8 | data[3]);   // "сырой" аксель Y
        int16_t az_raw  = (int16_t)(data[4] << 8 | data[5]);   // "сырой" аксель Z
        int16_t tempRaw = (int16_t)(data[6] << 8 | data[7]);   // "сырая" температура
        int16_t gx_raw  = (int16_t)(data[8] << 8 | data[9]);   // "сырой" гироскоп X
        int16_t gy_raw  = (int16_t)(data[10] << 8 | data[11]); // "сырой" гироскоп Y
        int16_t gz_raw  = (int16_t)(data[12] << 8 | data[13]); // "сырой" гироскоп Z

        // Применяем ранее вычисленные оффсеты и масштабы.
        // Эти оффсеты (ax_offset, gx_offset и т.п.) заполняются в calibrateMPU().
        //
        // Акселерометр:
        //   - в режиме ±2g чувствительность ≈ 16384 LSB/g,
        //   - поэтому (raw - offset) / 16384.0f даёт ускорение в "g".
        float ax = (ax_raw - ax_offset) / 16384.0f;  // ускорение по X, g
        float ay = (ay_raw - ay_offset) / 16384.0f;  // ускорение по Y, g
        float az = (az_raw - az_offset) / 16384.0f;  // ускорение по Z, g

        // Гироскоп:
        //   - в режиме ±250 dps чувствительность ≈ 131 LSB/(deg/s),
        //   - поэтому (raw - offset) / 131.0f даёт скорость вращения в deg/s.
        float gx = (gx_raw - gx_offset) / 131.0f;    // угловая скорость по X, deg/s
        float gy = (gy_raw - gy_offset) / 131.0f;    // по Y, deg/s
        float gz = (gz_raw - gz_offset) / 131.0f;    // по Z, deg/s

        // Температура:
        // по даташиту: Temp(C) = raw/340 + 36.53 + temp_offset.
        // сейчас temp_offset = 0.0f; если ты заметим, что реальная температура MPU 
        // (померенная внешним термометром) стабильно отличается, например, на +2 °C, 
        // то можно задать: temp_offset = -2.0f; 
        // и тем самым «подкрутить» показания, не трогая саму формулу.
        float tempC = (tempRaw / 340.0f) + 36.53f + temp_offset;

        // Сохраняем последние "сырые-нормированные" значения для логов и диагностики.
        // Эти переменные используются при логировании ошибки (см. блок "MPU state at error").
        ax_last   = ax;  ay_last   = ay;  az_last   = az;
        gx_last   = gx;  gy_last   = gy;  gz_last   = gz;
        temp_last = tempC;

        // Применяем экспоненциальное сглаживание alpha ко всем каналам MPU.
        // Идея:
        //   - снижать шум и дрожание в показаниях;
        //   - сделать HUD (горизонт, курс) более плавным.
        //
        // Формула: x_f = x_f + alpha * (x - x_f);
        //   alpha ~ 0.1 означает "90% прошлого, 10% нового" – достаточно плавно.
        ax_f   = ax_f   + alpha * (ax   - ax_f);
        ay_f   = ay_f   + alpha * (ay   - ay_f);
        az_f   = az_f   + alpha * (az   - az_f);
        gx_f   = gx_f   + alpha * (gx   - gx_f);
        gy_f   = gy_f   + alpha * (gy   - gy_f);
        gz_f   = gz_f   + alpha * (gz   - gz_f);
        temp_f = temp_f + alpha * (tempC - temp_f);

        // На основе сглаженных значений акселерометра вычисляем углы крена и тангажа.
        //
        // Крен (roll):  atan2(ay, az)
        //   - если наклонять плату вокруг оси X (крен), меняется соотношение ay/az.
        //
        // Тангаж (pitch): atan2(-ax, sqrt(ay^2 + az^2))
        //   - берём -ax, чтобы сохранялось привычное направление "нос вверх/вниз".
        float roll_rad_calc  = atan2(ay_f, az_f);                             // в радианах
        float pitch_rad_calc = atan2(-ax_f, sqrt(ay_f * ay_f + az_f * az_f)); // в радианах

        // Переводим углы из радиан в градусы
        float roll_raw_deg  = roll_rad_calc  * 180.0f / PI;
        float pitch_raw_deg = pitch_rad_calc * 180.0f / PI;

        // Применяем нули горизонта, сохранённые в:
        //   roll_zero_deg, pitch_zero_deg
        // Эти нули фиксируются:
        //   - при первом успешном initMPU();
        //   - либо при ручном сбросе нуля (manualZeroReset()).
        //
        // Если ноль горизонта уже известен (horizonZeroSet == true),
        // считаем roll_deg/pitch_deg как отклонение от этого нуля.
        if (horizonZeroSet) {
          roll_deg  = roll_raw_deg  - roll_zero_deg;   // крен относительно запомненного горизонта
          pitch_deg = pitch_raw_deg - pitch_zero_deg;  // тангаж относительно запомненного горизонта
        } else {
          // Если ноль горизонта ещё не зафиксирован – используем "сырые" углы.
          roll_deg  = roll_raw_deg;
          pitch_deg = pitch_raw_deg;
        }

        // Дополнительный фильтр по крену для расчёта виртуального курса.
        // --------------------------------------------------------------
        // roll_for_heading_deg – "более плавная" версия roll_deg,
        // которая используется ТОЛЬКО для интеграла курса (heading_deg).
        //
        // Причина:
        //   - мелкий шум по крену вызывает дрожание виртуального курса
        //     (так как мы интегрируем dRoll);
        //   - отдельный сглаженный канал позволяет сделать курс более "спокойным",
        //     не мешая быстрому отклику самого горизонта (roll_deg).
        roll_for_heading_deg =
          roll_for_heading_deg + HEADING_ROLL_ALPHA * (roll_deg - roll_for_heading_deg);

        // --------------------------------------------------------------------
        // [F18.2.3.1] Виртуальный курс по интегралу крена (heading_deg)
        // --------------------------------------------------------------------
        // Идея:
        //   - Мы НЕ используем магнитометр, поэтому "курс" берём искусственно:
        //   - интегрируем изменения крена (roll_for_heading_deg) по времени.
        //
        //   Примерно:
        //     - если поворачиваем "самолёт" вправо, крен меняется определённым
        //       образом, и мы трактуем это как разворот по курсу;
        //     - каждое изменение крена dRoll добавляем к heading_deg;
        //     - таким образом получаем "виртуальный курс".
        //
        //   heading_deg:
        //     - хранится в диапазоне 0..360 (с нормализацией);
        //     - ноль курса задаётся один раз:
        //          * при первом успешном initMPU() (см. [F08.7]),
        //          * или при ручном сбросе нуля manualZeroReset().
        if (!headingInitDone) {
          // Если по какой-то причине интегратор курса ещё не инициализирован
          // (обычно это делается в initMPU),
          // то инициализируем его здесь:
          //
          //   - считаем текущий курс равным 0;
          //   - запоминаем текущее значение крена (уже сглаженного roll_for_heading_deg)
          //     как "опорное" для будущих приращений dRoll.
          heading_deg           = 0.0f;                  // курс = 0
          last_roll_for_heading = roll_for_heading_deg;  // запоминаем текущий крен
          headingInitDone       = true;                  // интегратор готов работать
        } else {
          // Основной режим работы: интегрируем изменение крена.
          //
          // dRoll – изменение крена по отношению к предыдущему значению:
          //   dRoll > 0  -> крен вырос (наклон "в одну сторону")
          //   dRoll < 0  -> крен уменьшился (наклон "в другую сторону")
          float dRoll = roll_for_heading_deg - last_roll_for_heading;

          // Коррекция на переход через ±180°:
          // --------------------------------------------------------------
          // При больших поворотах может быть ситуация, когда крен "перескакивает"
          // через +180/-180 (например, было +179°, стало -179°).
          // В таком случае "сырая" разница dRoll ≈ -358°, хотя реальное
          // изменение угла около +2°.
          //
          // Чтобы избежать таких скачков, если dRoll выходит за ±180°, мы
          // компенсируем это добавлением/вычитанием 360°:
          if (dRoll > 180.0f)  dRoll -= 360.0f;
          if (dRoll < -180.0f) dRoll += 360.0f;

          // Теперь dRoll – "короткое" изменение крена, без искусственных скачков.
          // Интегрируем его в виртуальный курс:
          heading_deg += dRoll;

          // Нормализуем курс в диапазон 0..360°:
          //   - если ушли выше 360 -> вычитаем 360 до тех пор, пока не вернёмся
          //     в нужный диапазон;
          //   - если ушли ниже 0   -> добавляем 360.
          while (heading_deg >= 360.0f) heading_deg -= 360.0f;
          while (heading_deg <   0.0f) heading_deg += 360.0f;

          // Запоминаем текущее значение крена как "предыдущее"
          // для следующего шага интегрирования.
          last_roll_for_heading = roll_for_heading_deg;
        }
      }
    }
  }

  // --------------------------------------------------------------------------
  // [F18.3] ЧТЕНИЕ AHT/BMP (ENV) в METEO и HUD
  // --------------------------------------------------------------------------
  // Здесь организуем опрос "погодных" датчиков:
  //
  //   - AHT20: температура и влажность (aht_tC, aht_hR)
  //   - BMP280: давление и барометрическая высота (p_mmHg, altitude_m, altStep_m)
  //
  // Важно:
  //   * В METEO-режиме (displayMode == 0) опрашиваем ENV часто – каждые 500 мс
  //     (SENSOR_POLL_INTERVAL).
  //   * В HUD-режиме (displayMode == 1) опрашиваем ENV реже – раз в 2 секунды
  //     (HUD_SENSOR_POLL_INTERVAL), чтобы не загружать шину и не мешать MPU.
  //
  // Основная "тяжёлая" логика чтения/обработки высоты вынесена в pollEnvOnce().

  // --- METEO-режим ENV (частый опрос) ---
  if (displayMode == 0 && (now - lastSensorPoll >= SENSOR_POLL_INTERVAL)) {
    // Обновляем отметку времени последнего опроса для METEO
    lastSensorPoll = now;

    if (recovering) {
      // Если мы ещё в "тихом" периоде после reinitAllSensors(),
      // датчики ENV не трогаем – даём им стабилизироваться.
      Serial.println("ENV poll skipped: recovering after reinitAllSensors()");
    } else if (!aht_ok || !bmp_ok) {
      // Хотя бы один из ENV-датчиков в ошибке:
      //   - aht_ok == false -> AHT20 не в строю
      //   - bmp_ok == false -> BMP280 не в строю
      //
      // В этом случае пробуем перезапустить ВСЕ датчики (ENV+MPU) через
      // reinitAllSensors(), но не чаще, чем раз в ENV_RETRY_INTERVAL.
      static unsigned long lastEnvReinitTry = 0;
      const unsigned long ENV_RETRY_INTERVAL = 3000; // не чаще 1 раза в 3 секунды

      if (now - lastEnvReinitTry > ENV_RETRY_INTERVAL) {
        // Прошло достаточно времени с последней попытки – пробуем снова
        lastEnvReinitTry = now;
        Serial.println("ENV in ERR state on METEO -> reinitAllSensors()");
        reinitAllSensors("ENV errors on METEO");
      } else {
        // Слишком частые попытки восстановления ENV – текущую пропускаем
        Serial.println("ENV in ERR, but reinitAllSensors() suppressed (too frequent)");
      }

    } else {
      // Оба датчика ENV в порядке (aht_ok && bmp_ok == true) – нормальная работа.
      // Один опрос:
      //   - прочитать текущие T/H с AHT20,
      //   - прочитать давление/высоту с BMP280,
      //   - обновить сглаженную высоту altitude_m_f и "лестницу" altStep_m.
      pollEnvOnce();
    }
  }

  // --- HUD-режим ENV (редкий опрос) ---
  if (displayMode == 1 && (now - lastHudEnvPoll >= HUD_SENSOR_POLL_INTERVAL)) {
    // Обновляем отметку времени последнего опроса для HUD
    lastHudEnvPoll = now;

    if (recovering) {
      // В "тихом" периоде после reinitAllSensors() ENV тоже не трогаем
      Serial.println("ENV poll (HUD) skipped: recovering after reinitAllSensors()");
    } else if (!aht_ok || !bmp_ok) {
      // ENV в ошибке и мы находимся в HUD-режиме.
      // Здесь логика аналогична METEO, но с отдельным таймером и чуть
      // большим интервалом, чтобы не дёргать reinit слишком часто именно из HUD.
      static unsigned long lastEnvReinitTryHud = 0;
      const unsigned long ENV_RETRY_INTERVAL_HUD = 5000; // 1 попытка в 5 секунд

      if (now - lastEnvReinitTryHud > ENV_RETRY_INTERVAL_HUD) {
        // Давно не пытались восстановить ENV из HUD – делаем reinitAllSensors().
        lastEnvReinitTryHud = now;
        Serial.println("ENV in ERR state on HUD -> reinitAllSensors()");
        reinitAllSensors("ENV errors on HUD");
      } else {
        // Попытка восстановления слишком скоро после предыдущей – пропускаем.
        Serial.println("ENV in ERR (HUD), but reinitAllSensors() suppressed (too frequent)");
      }

    } else {
      // Оба ENV-датчика в рабочем состоянии – делаем один опрос в HUD.
      // Это обновит:
      //   - давление/высоту (для altStep_m в окне высоты HUD),
      //   - T/H (хотя они HUD напрямую не нужны, но полезно иметь "свежими").
      pollEnvOnce();
    }
  }
  // --------------------------------------------------------------------------
  // [F18.4] ТЕНДЕНЦИЯ ДАВЛЕНИЯ (METEO)
  // --------------------------------------------------------------------------
  // Здесь мы оцениваем, как меняется атмосферное давление со временем:
  //
  //   - работаем только в METEO-режиме (displayMode == 0), т.к. тренд нужен
  //     именно для "погодного" экрана;
  //   - только когда BMP280 в исправном состоянии (bmp_ok == true);
  //   - раз в TREND_INTERVAL миллисекунд (по умолчанию 10 минут) сравниваем
  //     текущее p_mmHg с опорным p_trend_ref и выбираем состояние:
  //       * T_STATE_RISE   – давление заметно выросло  (diff > +2 мм рт. ст.)
  //       * T_STATE_FALL   – давление заметно упало   (diff < -2 мм рт. ст.)
  //       * T_STATE_STEADY – изменений в пределах ±2 мм рт. ст.
  //
  // Результат сохраняется в global-переменную pressureTrend и отображается
  // на METEO-экране (см. updateEnvValues()).
  if (displayMode == 0 && bmp_ok) {
    // Если ещё ни разу не оценивали тренд (lastTrendTime == 0),
    // просто запоминаем текущее давление как опорное и время.
    if (lastTrendTime == 0) {
      lastTrendTime = now;   // текущий момент становится стартом отсчёта
      p_trend_ref   = p_mmHg; // опорное давление для сравнения в будущем

    } else if (now - lastTrendTime > TREND_INTERVAL) {
      // Прошло больше TREND_INTERVAL (например, 10 минут) с момента последней оценки.
      // Считаем разницу между текущим давлением и опорным:
      float diff = p_mmHg - p_trend_ref;

      // Интерпретируем разницу diff:
      //   diff > +2.0 мм рт. ст.  -> давление заметно растёт
      //   diff < -2.0 мм рт. ст.  -> давление заметно падает
      //   иначе                  -> считаем, что давление "стабильно"
      if (diff > 2.0f)       pressureTrend = T_STATE_RISE;    // растёт
      else if (diff < -2.0f) pressureTrend = T_STATE_FALL;    // падает
      else                   pressureTrend = T_STATE_STEADY;  // примерно постоянное

      // Обновляем опорное давление для следующего интервала:
      p_trend_ref   = p_mmHg;

      // И фиксируем новое время последней оценки тренда
      lastTrendTime = now;
    }
  }

  // --------------------------------------------------------------------------
  // [F18.5] КНОПКА: короткое нажатие – смена экрана,
  //                 длинное нажатие – ручной сброс нуля горизонта/курса
  // --------------------------------------------------------------------------
  // Кнопка подключена к D2 и настроена как INPUT_PULLUP:
  //   - в "покое" (не нажата) на пине лог.1 (HIGH);
  //   - при нажатии пин замыкается на GND -> лог.0 (LOW).
  //
  // Мы обрабатываем:
  //   - фронты (изменения HIGH/LOW) с антидребезгом;
  //   - различаем короткое и длинное нажатие по длительности удержания.
  //
  // Смысл:
  //   - короткое нажатие (< LONG_PRESS_MS) переключает METEO <-> HUD;
  //   - длинное (>= LONG_PRESS_MS) в HUD-режиме при живом MPU
  //     запускает manualZeroReset() – ручной сброс нуля горизонта и курса.
  bool buttonState = digitalRead(buttonPin);  // читаем текущее состояние пина: HIGH/LOW

  // Обработка фронта кнопки с антидребезгом по времени
  // --------------------------------------------------
  // Если состояние изменилось (HIGH->LOW или LOW->HIGH) и с момента последнего
  // изменения прошло больше DEBOUNCE_MS, считаем это "настоящим" фронтом.
  if (buttonState != lastButtonState &&
      (now - lastButtonChange) > DEBOUNCE_MS) {

    // Фиксируем момент изменения и новое состояние
    lastButtonChange = now;
    lastButtonState  = buttonState;

    if (buttonState == LOW) {
      // Кнопка только что НАЖАТА (переход HIGH -> LOW).
      // Считаем, что началось удержание:
      buttonPressed     = true;      // сейчас кнопку держат
      buttonPressStart  = now;       // запоминаем время начала нажатия
      longPressHandled  = false;     // длинное нажатие ещё не отработано

    } else {
      // Кнопка только что ОТПУЩЕНА (переход LOW -> HIGH).
      if (buttonPressed) {
        // Считаем, сколько времени она была зажата:
        unsigned long pressDur = now - buttonPressStart;

        // Условие КОРОТКОГО нажатия:
        //   - длинное нажатие ещё не было обработано (longPressHandled == false)
        //   - длительность удержания меньше LONG_PRESS_MS (например, < 1.5 с)
        if (!longPressHandled && pressDur < LONG_PRESS_MS) {
          // --- КОРОТКОЕ НАЖАТИЕ: переключение экрана METEO <-> HUD ---

          int oldMode = displayMode;          // запоминаем старый режим
          displayMode = (displayMode + 1) % 2; // 0 -> 1 -> 0 циклически

          if (displayMode == 0) {
            // Переход в METEO-режим:
            //   - рисуем каркас METEO (подписи/рамки)
            //   - обнуляем таймер экрана, чтобы сразу обновить значения
            drawEnvFrame();
            lastScreenUpdate = 0;
          } else {
            // Переход в HUD-режим:
            //   - очищаем под HUD (каркас рисуется в drawMPUFrame())
            //   - форсируем ближайший перерис HUD
            drawMPUFrame();
            lastScreenUpdate = 0;
          }

          // Логируем факт переключения режима и полезные параметры
          Serial.print("MODE_SWITCH: ");
          Serial.print(oldMode == 0 ? "METEO" : "HUD");
          Serial.print(" -> ");
          Serial.print(displayMode == 0 ? "METEO" : "HUD");
          Serial.print(" at ms=");
          Serial.print(now);

          // Дополнительно печатаем информацию по высоте (если ноль высоты уже зафиксирован)
          if (bmp_ok && altZeroRefSet) {
            float alt_rel_now = altitude_m_f - altZeroRef;  // относительная высота
            Serial.print("  ALT_rel=");
            Serial.print(alt_rel_now, 2);
            Serial.print("  ALT_f=");
            Serial.print(altitude_m_f, 2);
          }

          // И температуру MPU, если он в рабочем состоянии
          if (mpu_ok) {
            Serial.print("  MPU_T=");
            Serial.print(temp_f, 1);
          }
          Serial.println();
        }
      }

      // Вне зависимости от того, было короткое или длинное – при отпускании
      // считаем, что удержание кнопки завершилось.
      buttonPressed = false;
    }
  }

  // Проверка на ДЛИННОЕ нажатие, пока кнопка удерживается
  // -----------------------------------------------------
  // Здесь мы НЕ ждём отпускания кнопки: как только длительность превысила
  // LONG_PRESS_MS, сразу выполняем "длинное" действие (один раз).
  if (buttonPressed && !longPressHandled) {
    unsigned long pressDur = now - buttonPressStart;

    if (pressDur >= LONG_PRESS_MS) {
      // Считаем длинное нажатие отработанным, чтобы не срабатывало повторно,
      // пока кнопку ещё держат.
      longPressHandled = true;

      // Условие для ручного сброса нуля:
      //   - MPU должен быть в рабочем состоянии (mpu_ok == true),
      //   - режим должен быть HUD (displayMode == 1), т.к. сбрасываем
      //     именно ноль горизонта/курса HUD.
      if (mpu_ok && displayMode == 1) {
        // Ручной "сброс нуля" горизонта и курса (см. manualZeroReset()):
        //   - текущая ориентация -> roll_zero_deg/pitch_zero_deg;
        //   - heading_deg = 0;
        //   - флаги horizonZeroSet/headingZeroSet = true.
        manualZeroReset();
      } else {
        // Если MPU не в порядке или мы не в HUD – сброс нуля не выполняем.
        Serial.println("MANUAL ZERO RESET ignored (MPU not OK or not in HUD mode)");
      }
    }
  }

  // --------------------------------------------------------------------------
  // [F18.6] ПЕРИОДИЧЕСКИЙ ВЫВОД В SERIAL (METEO-режим)
  // --------------------------------------------------------------------------
  // Раз в serialPrintInterval (по умолчанию 60 секунд) печатаем в Serial
  // "сводку" по состоянию MPU и ENV:
  //   - температура MPU;
  //   - температура/влажность/точка росы по AHT20;
  //   - давление и тренд давления по BMP280;
  //   - накопленные счётчики ошибок по каждому датчику.
  //
  // Выводим это ТОЛЬКО в METEO-режиме (displayMode == 0), чтобы не
  // забивать лог, пока работаем в HUD.
  if (displayMode == 0 && now - lastSerialPrint > serialPrintInterval) {
    // Обновляем момент последнего вывода
    lastSerialPrint = now;

    // --- Блок по MPU ---
    Serial.print("MPU: ");
    if (mpu_ok) {
      // Если MPU в рабочем состоянии – выводим его температуру
      Serial.print("T="); Serial.print(temp_f, 1); Serial.print("C  ");
    } else {
      // Если MPU сейчас в ошибке – просто помечаем "ERR"
      Serial.print("ERR  ");
    }

    // --- Блок по ENV (AHT20) ---
    Serial.print("ENV: ");
    if (aht_ok) {
      // Температура воздуха
      Serial.print("T="); Serial.print(aht_tC, 1); Serial.print("C  ");

      // Влажность воздуха
      Serial.print("H=");
      Serial.print(aht_hR, 0); Serial.print("%  ");

      // Точка росы (расчётная по tC и hR)
      float dew = calcDewPoint(aht_tC, aht_hR);
      Serial.print("Dew="); Serial.print(dew, 1); Serial.print("C  ");
    } else {
      // Если AHT20 в ошибке – явно указываем, что нет данных по T/H
      Serial.print("AHT_ERR  ");
    }

    // --- Блок по давлению BMP280 ---
    if (bmp_ok) {
      // Текущее давление в мм рт. ст.
      Serial.print("P="); Serial.print(p_mmHg, 0); Serial.print("mmHg  pressureTrend=");

      // Печатаем состояние тренда давления:
      //   UP     -> давление растёт
      //   DOWN   -> давление падает
      //   STEADY -> практически не меняется
      //   N/A    -> тренд ещё не определён (T_STATE_TUNKNOWN)
      if (pressureTrend == T_STATE_RISE)        Serial.print("UP");
      else if (pressureTrend == T_STATE_FALL)   Serial.print("DOWN");
      else if (pressureTrend == T_STATE_STEADY) Serial.print("STEADY");
      else                                      Serial.print("N/A");
    } else {
      // Если BMP280 сейчас в ошибке – помечаем это
      Serial.print("BMP_ERR");
    }

    // --- Память ошибок по датчикам ---
    // Эти счётчики накапливаются за всё время работы и помогают
    // понять, сколько раз каждый датчик "сыпался".
    Serial.print("  memERR_AHT="); Serial.print(ahtErrCount);   // сколько раз AHT20 отваливался
    Serial.print("  memERR_BMP="); Serial.print(bmpErrCount);   // сколько раз BMP280 отваливался
    Serial.print("  memERR_MPU="); Serial.print(mpuErrCount);   // сколько раз были серьёзные ошибки MPU

    // Дополнительно – сколько ошибок MPU было при покое / в движении.
    // Эти значения накапливаются в блоке ошибок MPU ([F18.2.2]).
    Serial.print("  mpuErrStill="); Serial.print(mpuErrWhileStill);
    Serial.print("  mpuErrMove=");  Serial.print(mpuErrWhileMoving);
    Serial.println();
  }

  // --------------------------------------------------------------------------
  // [F18.7] ОБЩИЙ ЛОГ ВЫСОТЫ (раз в 1 секунду)
  // --------------------------------------------------------------------------
  // Этот блок каждую секунду (независимо от режима METEO/HUD) печатает в Serial
  // подробную информацию по барометрической высоте:
  //
  //   - altitude_m    : "сырая" относительная высота (после вычета altitudeOffset_m)
  //   - altitude_m_f  : сглаженная высота после фильтра
  //   - altZeroRef    : опорный "нулевой" уровень высоты (захватывается один раз
  //                     после периода стабилизации, см. pollEnvOnce())
  //   - alt_rel_now   : текущая относительная высота = altitude_m_f - altZeroRef
  //   - altState      : состояние "лестницы" высоты (ALT_IDLE / MOVING_UP / MOVING_DOWN)
  //   - altStep_m     : дискретная высота, которая отображается в HUD (окно Alt)
  //
  // Вывод в таком формате помогает видеть, как работает фильтрация и "лестница"
  // по высоте, и отлаживать пороги/фильтры при необходимости.
  static unsigned long lastAltDebugGlobal = 0;      // время последнего глобального лога высоты
  if (millis() - lastAltDebugGlobal > 1000) {       // если прошла как минимум 1 секунда
    lastAltDebugGlobal = millis();                  // обновляем отметку времени

    // Логируем высоту только если BMP280 в рабочем состоянии и
    // нулевой уровень высоты уже зафиксирован (altZeroRefSet == true).
    if (bmp_ok && altZeroRefSet) {
      // Текущая относительная высота (в метрах) относительно altZeroRef
      float alt_rel_now = altitude_m_f - altZeroRef;

      Serial.print("ALTLOG mode=");
      // Для наглядности указываем, в каком режиме сейчас находимся: METEO или HUD
      Serial.print(displayMode == 0 ? "METEO" : "HUD");

      Serial.print(" ms=");
      Serial.print(now);               // текущее время, мс с момента старта

      Serial.print(" raw=");
      Serial.print(altitude_m, 2);     // "сырая" высота (после вычета altitudeOffset_m)

      Serial.print(" f=");
      Serial.print(altitude_m_f, 2);   // сглаженная высота

      Serial.print(" zero=");
      Serial.print(altZeroRef, 2);     // опорный ноль высоты

      Serial.print(" rel=");
      Serial.print(alt_rel_now, 2);    // текущая относительная высота (f - zero)

      Serial.print(" state=");
      Serial.print((int)altState);     // состояние "лестницы" (0=IDLE, 1=UP, 2=DOWN)

      Serial.print(" step=");
      Serial.println(altStep_m, 2);    // дискретная "ступень" высоты для HUD
    }
  }

  // --------------------------------------------------------------------------
  // [F18.8] ОБНОВЛЕНИЕ ЭКРАНА (METEO / HUD)
  // --------------------------------------------------------------------------
  // Экран обновляем не "каждый цикл", а с заданной частотой:
  //
  //   - METEO (displayMode == 0):
  //       SCREEN_UPDATE_INTERVAL_METEO = 2000 мс
  //       -> обновление раз в 2 секунды.
  //
  //   - HUD (displayMode == 1):
  //       SCREEN_UPDATE_INTERVAL_HUD   = 200 мс
  //       -> примерно 5 кадров в секунду (достаточно для плавного горизонта).
  //
  // Логика:
  //   1) Выбираем интервал screenInt в зависимости от текущего режима.
  //   2) Если с момента последнего обновления (lastScreenUpdate) прошло
  //      больше, чем screenInt, то:
  //        - запоминаем текущее время в lastScreenUpdate;
  //        - перерисовываем нужный экран.
  //
  // Замечание:
  //   - переменная lastScreenUpdate иногда принудительно сбрасывается в 0
  //     (например, при переключении режима в [F18.5]), чтобы форсировать
  //     немедленное обновление экрана в этом же цикле.
  unsigned long screenInt = (displayMode == 0)
                            ? SCREEN_UPDATE_INTERVAL_METEO    // если METEO
                            : SCREEN_UPDATE_INTERVAL_HUD;     // если HUD

  // Проверяем, пришло ли время обновлять экран
  if (now - lastScreenUpdate > screenInt) {
    // Фиксируем момент последнего обновления
    lastScreenUpdate = now;

    if (displayMode == 0) {
      // --- METEO-режим ---
      // Каркас METEO (подписи, разметка) рисуется один раз в drawEnvFrame()
      // при входе в режим. Здесь каждый раз просто обновляем числовые значения:
      //   - температура, влажность, точка росы,
      //   - давление, тренд,
      //   - температура MPU,
      //   - статусы датчиков и их "память ошибок".
      updateEnvValues();

    } else {
      // --- HUD-режим ---
      if (mpu_ok) {
        // Если MPU в рабочем состоянии – рисуем HUD целиком:
        //   - линии горизонта, дуга крена, самолётик;
        //   - шкалы крена и тангажа;
        //   - окно высоты (altStep_m);
        //   - верхнюю шкалу виртуального курса;
        //   - численные значения крена/тангажа.
        drawHud();
      } else {
        // Если MPU в ошибке – вместо HUD показываем простое сообщение "MPU ERR"
        // на фиолетовом фоне, чтобы было видно, что ориентация недоступна.
        tft.fillScreen(COL_FON1);
        tft.setTextColor(ST77XX_RED, COL_FON1);
        tft.setTextSize(1);

        int16_t h = tft.height();
        tft.setCursor(10, h / 2 - 4);
        tft.print("MPU ERR");
      }
    }
  }
}